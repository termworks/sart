[Unit]
Description=ASCII boot animation
DefaultDependencies=no
After=systemd-vconsole-setup.service
Before=initrd-root-fs.target
ConditionPathExists=/dev/tty1
ConditionKernelCommandLine=!bootart=0

[Service]
Type=simple
ExecStart=-/usr/lib/bootart/bootart play --duration-ms 2500 --fps 30 --clear-first --leave-final
StandardInput=null
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=no
TTYVHangup=no
TTYVTDisallocate=no
KillSignal=SIGTERM
TimeoutStopSec=250ms

[Install]
WantedBy=initrd.target
