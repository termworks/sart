#!/bin/busybox sh
# TEST INFRASTRUCTURE ONLY. BusyBox init runs this as an ordinary sysinit child.

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

PASS_MARKER='BOOTART_VM_LIFECYCLE_PASS_V1'
FAIL_MARKER='BOOTART_VM_LIFECYCLE_FAIL_V1'

serial_write() {
    # Start on a fresh line even if the renderer's last frame had no newline.
    printf '\n%s\n' "$1" > /dev/ttyS0
}

fail() {
    serial_write "$FAIL_MARKER:$1"
    /bin/busybox poweroff -f >/dev/null 2>&1 || true
    while :; do /bin/busybox sleep 60; done
}

/bin/busybox mount -t devtmpfs devtmpfs /dev || true
/bin/busybox mount -t proc proc /proc || fail mount-proc
/bin/busybox mount -t sysfs sysfs /sys || fail mount-sys

# Keep the oracle byte-exact instead of allowing tty ONLCR to add CR bytes.
/bin/busybox stty -F /dev/ttyS0 -opost >/dev/null 2>&1 || fail serial-stty

[ "$$" -gt 1 ] || fail sysinit-script-became-pid1
pid1_exe="$(/bin/busybox readlink /proc/1/exe 2>/dev/null || true)"
case "$pid1_exe" in
    */busybox) ;;
    *bootart*) fail bootart-is-pid1 ;;
    *) fail pid1-is-not-busybox-init ;;
esac
pid1_cmdline="$(/bin/busybox tr '\000' ' ' < /proc/1/cmdline 2>/dev/null || true)"
case "$pid1_cmdline" in
    *init*) ;;
    *) fail pid1-is-not-init-applet ;;
esac

[ -x /opt/bootart/bootart ] || fail product-missing

render_tty=/dev/ttyS0
duration_ms=1500
gui_preview=0
password_preview=0
case " $(/bin/busybox cat /proc/cmdline 2>/dev/null || true) " in
    *' bootart.vm.gui-password=1 '*)
        render_tty=/dev/tty0
        gui_preview=1
        password_preview=1
        ;;
    *' bootart.vm.gui=1 '*)
        render_tty=/dev/tty0
        duration_ms=4000
        gui_preview=1
        ;;
esac

# Run the product as an ordinary child. This finite command is only a hardened
# lifecycle smoke probe; later gates exercise daemon/switch-root/askpass.
if [ "$password_preview" -eq 1 ]; then
    [ -x /usr/sbin/cryptsetup ] || fail guest-cryptsetup-missing
    /bin/busybox modprobe virtio_blk >/dev/null 2>&1 ||
        fail guest-virtio-block-module-load
    drive_ready=0
    for _ in $(/bin/busybox seq 1 50); do
        if [ -b /dev/vda ]; then
            drive_ready=1
            break
        fi
        /bin/busybox mdev -s >/dev/null 2>&1 || true
        /bin/busybox sleep 0.1
    done
    [ "$drive_ready" -eq 1 ] || fail encrypted-qemu-drive-missing
    for module in \
        /opt/bootart-vm/modules/dm-mod.ko \
        /opt/bootart-vm/modules/encrypted-keys.ko \
        /opt/bootart-vm/modules/dm-crypt.ko
    do
        [ -f "$module" ] || fail guest-dm-crypt-module-missing
        /bin/busybox insmod "$module" >/dev/null 2>&1 || fail guest-dm-crypt-module-load
    done

    /opt/bootart/bootart daemon --mode boot --password-broker native \
        --fps 30 --cycle-ms 2500 </dev/null >/dev/null 2>&1 &
    bootart_pid=$!
    [ "$bootart_pid" -gt 1 ] || fail product-child-pid
    /bin/busybox sleep 1
    [ -e "/proc/$bootart_pid/exe" ] || fail product-exited-too-early
    child_exe="$(/bin/busybox readlink "/proc/$bootart_pid/exe" 2>/dev/null || true)"
    case "$child_exe" in
        */bootart) ;;
        *) fail wrong-child-executable ;;
    esac

    ready=0
    for _ in $(/bin/busybox seq 1 100); do
        if /opt/bootart/bootart native-ready >/dev/null 2>&1; then
            ready=1
            break
        fi
        /bin/busybox sleep 0.1
    done
    [ "$ready" -eq 1 ] || fail native-password-broker-not-ready

    unlocked=0
    attempt=1
    test_passphrase_hint=112
    test_passphrase_hint="${test_passphrase_hint}358"
    while [ "$attempt" -le 3 ]; do
        serial_write 'BOOTART_VM_GUI_PASSWORD_PROMPT_V1'
        (
            /opt/bootart/bootart native-askpass \
                --adapter initramfs-tools-busybox \
                --prompt "Enter test passphrase $test_passphrase_hint (attempt $attempt of 3)" \
                --attempts 3 --maximum-secret-bytes 128 \
                8>&1 </dev/null >/dev/null 2>&1
        ) | /usr/sbin/cryptsetup open --type luks2 --key-file - \
            /dev/vda bootart-test >/dev/null 2>&1
        if [ "$?" -eq 0 ] && [ -b /dev/mapper/bootart-test ]; then
            unlocked=1
            break
        fi
        /opt/bootart/bootart message \
            'Wrong passphrase; try again' >/dev/null 2>&1 || true
        /bin/busybox sleep 1
        attempt=$((attempt + 1))
    done
    unset test_passphrase_hint

    if [ "$unlocked" -eq 1 ]; then
        /opt/bootart/bootart message \
            'Encrypted QEMU drive unlocked' >/dev/null 2>&1 || true
        /bin/busybox sleep 2
        /usr/sbin/cryptsetup close bootart-test >/dev/null 2>&1 || \
            fail encrypted-qemu-drive-close
        /opt/bootart/bootart quit >/dev/null 2>&1 || \
            fail password-splash-quit
        wait "$bootart_pid" || fail product-exit
        printf '\033[2J\033[HBootart exited. Guest boot continued successfully.\n' \
            >"$render_tty"
        serial_write 'BOOTART_VM_GUI_PASSWORD_PASS_V1'
        /bin/busybox sleep 3
    else
        /opt/bootart/bootart message \
            'Encrypted QEMU drive remained locked' >/dev/null 2>&1 || true
        /bin/busybox sleep 2
        /opt/bootart/bootart quit >/dev/null 2>&1 || true
        wait "$bootart_pid" 2>/dev/null || true
        fail encrypted-qemu-drive-unlock
    fi
elif [ "$gui_preview" -eq 1 ]; then
    # Clear both the previous kernel/initramfs text and the cursor position.
    # Keep color enabled: the animation engine intentionally becomes a static
    # fully-visible logo under --no-color.
    printf '\033[2J\033[H' >"$render_tty"
    /opt/bootart/bootart play \
        --duration-ms "$duration_ms" --fps 30 --seed 42 --clear-first \
        --cols 80 --rows 24 >"$render_tty" 2>&1 &
else
    /opt/bootart/bootart play \
        --duration-ms "$duration_ms" --fps 10 --seed 42 --no-color \
        --cols 80 --rows 24 >"$render_tty" 2>&1 &
fi
if [ "$password_preview" -eq 0 ]; then
    bootart_pid=$!
    [ "$bootart_pid" -gt 1 ] || fail product-child-pid
    /bin/busybox sleep 1
    [ -e "/proc/$bootart_pid/exe" ] || fail product-exited-too-early
    child_exe="$(/bin/busybox readlink "/proc/$bootart_pid/exe" 2>/dev/null || true)"
    case "$child_exe" in
        */bootart) ;;
        *) fail wrong-child-executable ;;
    esac
    wait "$bootart_pid" || fail product-exit
    if [ "$gui_preview" -eq 1 ]; then
        printf '\033[2J\033[HBootart exited. Guest userspace boot continued.\n' \
            >"$render_tty"
        /bin/busybox sleep 3
    fi
fi
serial_write "$PASS_MARKER"
/bin/busybox sync
/bin/busybox poweroff -f >/dev/null 2>&1 || true
while :; do /bin/busybox sleep 60; done
