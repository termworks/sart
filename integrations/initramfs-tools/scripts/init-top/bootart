#!/bin/sh

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

# Check for bootart=0 token in /proc/cmdline
if grep -q '\bbootart=0\b' /proc/cmdline 2>/dev/null; then
    exit 0
fi

TTY=/dev/tty1

if [ ! -c "$TTY" ]; then
    TTY=/dev/console
fi

if [ -c "$TTY" ]; then
    /usr/lib/bootart/bootart \
        play \
        --duration-ms 2500 \
        --fps 30 \
        --clear-first \
        --leave-final \
        >"$TTY" 2>/dev/null &
fi

exit 0
